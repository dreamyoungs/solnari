{
  "name": "@solnari/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server.cjs",
    "format": "prettier --write \"src/**/*.{ts,cjs}\" \"test/**/*.ts\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,cjs}\" \"test/**/*.ts\" package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.8.3",
    "google-auth-library": "^10.4.1",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
